<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <key>Label</key>
    <string>edu.calendar.refresh</string>

    <key>ProgramArguments</key>
    <array>
      <string>__UV_PATH__</string>
      <string>run</string>
      <string>python</string>
      <string>modify_calendar.py</string>
      <string>--config</string>
      <string>__PROJECT_ROOT__/config.toml</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
      <key>PATH</key>
      <string>__PATH__</string>
      <key>CALENDAR_ICAL_URL</key>
      <string>__UPSTREAM_CALENDAR_URL__</string>
      <key>SIRIUS_CALENDAR_CONFIG</key>
      <string>__PROJECT_ROOT__/config.toml</string>
    </dict>

    <key>RunAtLoad</key>
    <true />

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StartInterval</key>
    <integer>900</integer>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/logs/refresh.out.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/logs/refresh.err.log</string>
  </dict>
</plist>
